---
interface Props {
    href: string;
    class?: string;
}

const { class: className = "", ...rest } = Astro.props;
const external = !String(rest.href).startsWith("mailto:");
---

{/* A ruled index entry: the underline is always there, and thickens into the
    accent on hover. No pill, no shadow, no lift. */}
<a
    class:list={[
        "group inline-flex max-w-fit items-center gap-2 border-b border-line pb-1 font-mono text-xs text-fg-muted transition-colors duration-200 hover:border-accent hover:text-accent",
        className,
    ]}
    {...rest}
    target={external ? "_blank" : undefined}
    rel={external ? "noopener noreferrer" : undefined}
>
    <slot />
</a>
