---
const SRC = "/assets/joel-1400.jpg";
const SRCSET = "/assets/joel-900.jpg 675w, /assets/joel-1400.jpg 1050w";
const SIZES = "(min-width: 1024px) 420px, 100vw";
const ALT = "Portrait of Joel Gauchia";
---

{/* The portrait ships as an ink plate: monochrome, high contrast, sitting in
    the paper palette. Full colour exists underneath and is uncovered only
    where the pointer passes — a loupe moving over the plate. */}
<figure class="portrait select-none">
    <div
        id="portrait-frame"
        class="frame relative aspect-[4/5] overflow-hidden border border-line"
    >
        <img
            class="plate absolute inset-0 size-full object-cover"
            src={SRC}
            srcset={SRCSET}
            sizes={SIZES}
            alt={ALT}
            width="1050"
            height="1400"
            loading="eager"
            fetchpriority="high"
            decoding="async"
        />

        <img
            class="reveal-layer absolute inset-0 size-full object-cover"
            src={SRC}
            srcset={SRCSET}
            sizes={SIZES}
            alt=""
            aria-hidden="true"
            width="1050"
            height="1400"
            loading="eager"
            decoding="async"
        />
    </div>

    {/* The affordance sits outside the frame so it never fights the image,
        and retires as soon as the visitor has found the interaction. */}
    <figcaption class="hint label mt-3 text-fg-subtle">
        <span class="on-hover">Move over to develop</span>
        <span class="on-touch">Tap around to develop</span>
    </figcaption>
</figure>

<style>
    .frame {
        --x: 50%;
        --y: 50%;
    }

    /* The plate. Warmed slightly so the monochrome reads as ink on paper
       rather than as a desaturated photograph. */
    .plate {
        filter: grayscale(1) sepia(0.28) contrast(1.12) brightness(1.02);
    }

    :global(.dark) .plate {
        filter: grayscale(1) sepia(0.16) contrast(1.18) brightness(0.82);
    }

    .reveal-layer {
        opacity: 0;
        transition: opacity 0.4s var(--ease-out-quint);
        -webkit-mask-image: radial-gradient(
            circle 150px at var(--x) var(--y),
            #000 55%,
            transparent 100%
        );
        mask-image: radial-gradient(
            circle 150px at var(--x) var(--y),
            #000 55%,
            transparent 100%
        );
    }

    .frame[data-active] .reveal-layer {
        opacity: 1;
    }

    .hint {
        opacity: 1;
        transition: opacity 0.5s var(--ease-out-quint);
    }

    .portrait:has(.frame[data-used]) .hint {
        opacity: 0;
    }

    .on-touch {
        display: none;
    }

    @media (hover: none) {
        .on-hover {
            display: none;
        }
        .on-touch {
            display: inline;
        }
    }
</style>

<script>
    const frame = document.getElementById("portrait-frame");

    if (frame) {
        // Where the loupe sits, in coordinates local to the plate.
        const aim = (event: MouseEvent | PointerEvent) => {
            const box = frame.getBoundingClientRect();
            frame.style.setProperty("--x", `${event.clientX - box.left}px`);
            frame.style.setProperty("--y", `${event.clientY - box.top}px`);
        };

        // Both inputs move the same loupe. Only the way you aim it differs:
        // a pointer carries it along, a finger places it where it lands.
        // A tap is deliberately not a drag — dragging would have to claim the
        // touch gesture, and the plate is tall enough that swallowing scroll
        // on it would cost more than the interaction is worth.
        if (matchMedia("(hover: hover)").matches) {
            frame.addEventListener("pointermove", aim);

            frame.addEventListener("pointerenter", (event) => {
                aim(event);
                frame.setAttribute("data-active", "");
                frame.setAttribute("data-used", "");
            });

            frame.addEventListener("pointerleave", () =>
                frame.removeAttribute("data-active")
            );
        } else {
            frame.addEventListener("click", (event) => {
                const showing = frame.hasAttribute("data-active");
                const box = frame.getBoundingClientRect();
                const x = event.clientX - box.left;
                const y = event.clientY - box.top;
                const from = {
                    x: parseFloat(frame.style.getPropertyValue("--x")) || 0,
                    y: parseFloat(frame.style.getPropertyValue("--y")) || 0,
                };

                // Tapping somewhere new moves the loupe; tapping where it
                // already is puts it away.
                const nearby = Math.hypot(x - from.x, y - from.y) < 60;

                aim(event);
                frame.toggleAttribute("data-active", !(showing && nearby));
                frame.setAttribute("data-used", "");
            });
        }
    }
</script>
