---
import ExperienceItem from "./ExperienceItem.astro";
const EXPERIENCE = [
    {
        date: "March 2025 - Present",
        title: "Software Engineer at AD Parts",
        description:
            "Took part in the development of a platform that connects partners and customers, facilitating the distiribution of automotive spare parts."
    },
    {
        date: "May 2024 - March 2025",
        title: "Full-Stack Developer at Sunset Technologies",
        description:
            "Developed and maintained eFarma, an advanced e-prescription platform that streamlines the medication prescription process for healthcare professionals. " 
            + " Which reduced the time spent on the prescription process by 30%.",
        link: "https://www.sunset-technologies.net/ca/efarma/",
    },
    {
        date: "June 2023",
        title: "Internship at Sunset Technologies",
        description:
            "Implemented an internal back-end microservice to obtain core information from the company's database. Developed new features for full-stack web applications. Maintaned existent applications.",
    }
];
---

<ol class="relative border-s border-gray-200 ">
    {
        EXPERIENCE.map((experience) => (
            <li class="mb-10 ms-4">
                <ExperienceItem {...experience} />
            </li>
        ))
    }
</ol>
