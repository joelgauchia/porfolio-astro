---
import ProjectItem from "./ProjectItem.astro"

const PROJECTS = [
    {
        title: "Roomly",
        description: "An app that helps you find the perfect room for your next trip. It allows you to search for rooms in different cities, view details, and book them.",
        link: "http://194.164.72.178",
        github: 'https://github.com/joelgauchia/RoomlyBackend',
        image: 'https://i.ibb.co/ZRykR3MJ/phones.png',
        tags: ['Angular', 'Typescript', 'PrimeNG', 'Java', 'Spring Boot', 'Spring Security', 'Spring JPA', 'MySQL', 'Docker', 'Google OAuth 2.0', 'Google Maps API']
    },
    {
        title: "ConnectaGym",
        description: "Built for gym chain owners. It allows them to manage all their gyms from one dashboard.",
        image: 'https://i.ibb.co/84d7Fs9j/macbook.png',
        tags: ['Angular', 'Typescript', 'PrimeNG', 'Java', 'Spring Boot', 'Spring Security', 'Spring JPA', 'MySQL'],
        demo: true
    }
]
---

<ol class="grid grid-cols-1 gap-10 lg:grid-cols-2">
    {
        PROJECTS.map((project) => (
            <ProjectItem {...project}>
                {project}
            </ProjectItem>
        ))
    }