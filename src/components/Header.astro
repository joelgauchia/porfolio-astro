---
const NAV_TITLES = [
    { title: "Home", label: 'home', link: "#top" },
    { title: "Experience", label: 'experience', link: "#experience" },
    { title: "Projects", label: 'projects', link: "#projects" },
    { title: "Contact", label: 'contact', link: "#contact" },
]
---

<header class="flex flex-row mx-auto justify-center items-center py-5 w-full xl:w-[1120px]">
    <nav class="flex gap-x-4 text-sm lg:gap-x-10 opacity-80">
        {
            NAV_TITLES.map(({ title, link }) => (
                <a class="nav-link" href={link}>{title}</a>
            ))
        }
    </nav>
</header>