	},
	{
		slug: "salamence-ex",
		name: "Salamence ex",
		set: "Clash of the Blue Sky · 1st ed.",
		number: "064/082",
		year: "2004",
		grade: "8",
		gradeLabel: "Near Mint–Mint",
		cert: "151150219",
		illustrator: "Hikaru Koike",
	},
	{
		slug: "palkia-lv-x",
		name: "Palkia LV.X",
		set: "Diamond & Pearl · Cry from the Deep, 1st ed.",
		number: "DP3",
		year: "2007",
		grade: "9",
		gradeLabel: "Mint",
		cert: "148042755",
		illustrator: "Ryo Ueda",
	},
	{
		slug: "lugia",
		name: "Lugia",
		set: "Neo Genesis",
