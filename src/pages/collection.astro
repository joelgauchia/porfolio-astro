		cert: "150072623",
		illustrator: "5ban Graphics",
	},
	{
		slug: "poliwrath",
		name: "Poliwrath",
		set: "EX FireRed & LeafGreen · reverse foil",
		number: "11/112",
		year: "2004",
		grade: "9",
		gradeLabel: "Mint",
		cert: "87117740",
		illustrator: "Ken Sugimori",
	},
	{
		slug: "raichu-ex",
		name: "Raichu ex",
		set: "Miracle of the Desert · 1st ed.",
		number: "023/053",
		year: "2003",
		grade: "6",
		gradeLabel: "Ex-Mint",
		cert: "139812450",
